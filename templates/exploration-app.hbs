<div class="pf2e-eat scrollable" data-tooltip-class="pf2e">

    <section>

        {{!-- Header For Supported Activities --}}
        <header class="content-header">
            <a>Supported Activities</a>
            <div class="buttons">
                <button>Reroll Activities</button>
                <button>Apply All Effects</button>
            </div>
        </header>
        
        {{!-- Supported Activities --}}
        <div class="activities flex-column">
            {{#each activities}}
            {{#if supported}}
            {{!-- For Each Supported Activity --}}
            {{!-- Main container for an activity --}}
            <section class="activity-block flex-row">

                {{!-- Contains an Activity's Name, Link to Sheet, and Traits --}}
                <section class="activity flex-column">
                    <a class="name" data-action="openItemSheet" data-item-uuid="{{activity.uuid}}">{{activity.name}}</a>
                    <span class="tags">
                        {{#each traits}}
                            <span class="tag" data-tooltip="{{tooltip}}">{{name}}</span>
                        {{/each}}
                    </span>
                </section>

                {{!-- Contains all Actors using the Activity --}}
                <section class="actors flex-column">
                    {{#each players}}
                    {{!-- Contains single Actor's information related to the Activity --}}
                    <section class="actor-block flex-row">          

                        {{!-- Actor's Image and Name with link to Sheet --}}
                        <a class="actor-info flex-column" data-action="openActorSheet" data-actor-id={{actor.id}} data-tab="exploration">
                            <img src={{actor.img}}>
                            <span class="name">{{actor.name}}</span>
                        </a>

                        {{#if roll}}
                        {{!-- Contains information related to Activities that need Rolls --}}
                        <section class="activity-outcome-block flex-column">
                            
                            {{!-- Shows Roll outcome and Reroll button --}}
                            <div class="roll-container flex-row">
                                <div class="d20">
                                    <span>{{roll.rollValue}}</span>
                                </div>
                                <span> + {{roll.totalModifier}} = {{add roll.rollValue roll.totalModifier}}</span>
                                <a data-action="reroll" data-activity-name="{{../activity.name}}" data-actor-name="{{actor.name}}" data-total-modifier="{{roll.totalModifier}}">
                                    <i class="fa-solid fa-rotate rotate clickable-icon"></i>
                                </a>
                            </div>

                            {{!-- Shows modifiers that affected the roll --}}
                            <span class="tags">
                                {{#each roll.enabledModifiers}}

                                    {{! Make tag clickable if parent exists }}
                                    {{#if rule.parent.id}}
                                        <a>
                                    {{/if}}

                                    <span class="tag tag_transparent" 
                                        data-slug="{{slug}}"
                                        {{! If parent item exists create link data needed to open it }}
                                        {{#if rule.parent.id}}
                                        data-tooltip="Open [{{rule.parent.name}}]" data-action="openItemSheet" data-item-uuid="{{rule.parent.uuid}}"
                                        {{/if}}>
                                        {{label}}{{isPositive modifier}}{{modifier}}
                                    </span>

                                    {{#if rule.parent.id}}
                                        </a>
                                    {{/if}}

                                {{/each}}                               
                            </span>

                            {{#if roll.potentialModifiers}}
                            {{!-- If there are potential modifiers, show them as well --}}
                            <span class="potential-modifiers">Potential Modifiers</span>
                            <span class="tags">
                                {{#each roll.potentialModifiers}}

                                    {{! Make tag clickable if parent exists }}
                                    {{#if rule.parent.id}}
                                        <a>
                                    {{/if}}
                                        
                                    <span class="tag tag_transparent" 
                                        data-slug="{{slug}}" 
                                        {{#if rule.parent.id}}
                                        data-tooltip="Open [{{rule.parent.name}}]" data-action="openItemSheet" data-item-uuid="{{rule.parent.uuid}}"
                                        {{/if}}>
                                        {{label}} {{isPositive modifier}}{{modifier}}
                                    </span>

                                    {{#if rule.parent.id}}
                                        </a>
                                    {{/if}}
                                    
                                {{/each}}                                
                            </span>
                            {{/if}}
                        </section>

                        {{else if button}}
                        {{!-- If Activity requires a button, add button instead of roll information --}}
                        <section class="activity-outcome-block flex-column">
                            <button data-action="{{button.dataAction}}" data-actor-id="{{actor.id}}">{{button.label}}</button>
                        </section>
                        {{/if}}

                    </section>
                    {{/each}}
                </section>
            </section>
            {{/if}}
            {{/each}}
        </div>
        <header class="content-header">
            <a>Other Activities</a>
        </header>
        <div class="activities flex-column">
            {{#each activities}}
            {{#if unsupported}}
            <section class="activity-block flex-row">
                <section class="activity flex-column">                   
                    <a class="name" data-action="openItemSheet" data-item-uuid="{{activity.uuid}}">{{activity.name}}</a>
                    <span class="tags">
                        {{#each traits}}
                            <span class="tag" data-tooltip="{{tooltip}}">{{name}}</span>
                        {{/each}}
                    </span>                        
                </section>
                <section class="actors flex-column">
                    {{#each players}}
                    <section class="actor-block flex-row">                                                 
                        <a class="actor-info flex-column" data-action="openActorSheet" data-actor-id={{actor.id}} data-tab="exploration">
                            <img src={{actor.img}}>
                            <span class="name">{{actor.name}}</span>
                        </a>
                    </section>
                    {{/each}}
                </section>
            </section>
            {{/if}}
            {{/each}}
        </div>
    </section>



    <table class="exploration-table">

        {{! --------------- Suported Activities ------------------}}
        <tr>
            <th colspan="3">Supported Activities</th>
        </tr>
        <tr>
            <th>Activity</th>
            <th>Name</th>
            <th>Misc</th>
        </tr>

        {{! Create HTML for each activity, each player using them, and misc data like roll results and buttons}}
        {{#each activities}}
        {{#if supported}}
        <tr>
            
            {{! Create HTML for activity column and make is span a number of rows to match how many players are using it}}
            <th rowspan="{{eatObjLength players}}">
                {{{enrichedHTML}}}
            </th>

            {{! Create HTML for player's name and misc table columns}}
            {{#each players}}
                
                <th class="player-name"><strong>{{actor.name}}</strong></th>
                
                {{! If a roll property exists create HTML for the roll}}
                {{#if roll}}
                    <th>
                        
                        {{! Add Roll result}} 
                        <div class="roll-text">
                            <span data-tooltip="{{roll.rollValue}} + {{roll.totalModifier}}">{{add roll.rollValue roll.totalModifier}}</span>
                            <a data-action="reroll" data-activity-name="{{../activity.name}}" data-actor-name="{{actor.name}}" data-total-modifier="{{roll.totalModifier}}">
                                    <i class="fa-solid fa-rotate rotate clickable-icon"></i>
                            </a>
                        </div>

                        {{! Add modifier boxes for enabled modifiers }}
                        <div class="tags modifiers" style="justify-content:center;">
                        {{#each roll.enabledModifiers}}
                        
                            {{! Make tag clickable if parent exists }}
                            {{#if rule.parent.id}}<a>{{/if}}

                            <span class="tag tag_transparent" 
                                data-slug="{{slug}}"
                                {{! If parent item exists create link data needed to open it }}
                                {{#if rule.parent.id}}
                                data-tooltip="Open [{{rule.parent.name}}]"
                                data-action="openItemSheet"
                                data-item-id="{{rule.parent.id}}"
                                data-player-id="{{../actor.id}}"
                                {{/if}}>{{label}} {{isPositive modifier}}{{modifier}}</span>

                            {{#if rule.parent.id}}</a>{{/if}}
                            
                        {{/each}}
                        </div>

                        {{#if roll.potentialModifiers}}
                        <hr>
                        <span>Potential Modifiers</span>

                        {{! Add modifier boxes for potential modifiers}}
                        <div class="tags modifiers" style="justify-content:center;">
                        {{#each roll.potentialModifiers}}

                            {{! Make tag clickable if parent exists }}
                            {{#if rule.parent.id}}<a>{{/if}}
                                
                            <span class="tag tag_transparent" 
                                data-slug="{{slug}}" 
                                {{#if rule.parent.id}}
                                data-tooltip="Open [{{rule.parent.name}}]"
                                data-action="openItemSheet" 
                                data-item-id="{{rule.parent.id}}" 
                                data-player-id="{{../actor.id}}"
                                {{/if}}>{{label}} {{isPositive modifier}}{{modifier}}</span>

                            {{#if rule.parent.id}}</a>{{/if}}
                        {{/each}}
                        {{/if}}
                        </div>
                    </th>

                {{! If a button property exists creat HTML for Button}}
                {{else if button}}
                    <th><button data-action="{{button.dataAction}}" data-actor-id="{{actor.id}}">{{button.label}}</button></th>

                {{! If neither button or roll exist display a user tip or leave blank}}
                {{else}}
                    <td>tip</td>
                {{/if}}
                </tr>
            {{/each}}
        </tr>
        {{/if}}
        {{/each}}
    </table>


    {{! --------------  Other Activities  -----------------}}
    <table class="exploration-table">
        <tr>
            <th colspan="2">Other Activities</th>
        </tr>
        <tr>
            <th>Activity</th>
            <th>Name</th>
        </tr>
        {{#each activities}}
        {{#if unsupported}}
        <tr>
            {{! Create HTML for activity column and make is span a number of rows to match how many players are using it}}
            <th rowspan="{{eatObjLength players}}">
                {{{enrichedHTML}}}
            </th>
            {{! Create HTML for player's name and misc table columns}}
            {{#each players}}
                <th class="player-name"><strong>{{actor.name}}</strong></th>
            {{/each}}
        </tr>       
        {{/if}}
        {{/each}}   
    </table>
</div>